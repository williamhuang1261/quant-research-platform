<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.williamhuang1261.qrp</groupId>
    <artifactId>qrp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>qrp-warehouse</artifactId>
  <name>QRP :: Warehouse</name>
  <description>
    A real PostgreSQL persistence layer: a small star schema (instrument and
    strategy dimensions, price-bar and backtest/report-run facts) reached
    through hand-written JDBC, no ORM, matching the platform's existing
    dependency-light habit. Framework-free by design, like every other
    domain module here -- only qrp-api is Spring-aware.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.williamhuang1261.qrp</groupId>
      <artifactId>qrp-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.williamhuang1261.qrp</groupId>
      <artifactId>qrp-data</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Runs the real PostgreSQL server binary as a managed subprocess, with
         no Docker daemon and no external account needed: this machine's
         Docker CLI is installed but its daemon is not running, confirmed
         while planning this module, so a Testcontainers/docker-compose
         design would have been undemoable here and on a reviewer's laptop
         with the same gap. See docs/spec-warehouse.md. -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>2.1.0</version>
    </dependency>
  </dependencies>
</project>
